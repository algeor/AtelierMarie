# Copy to .env.docker for Docker Compose deployments.
# Do not commit real secrets.

# Backend
ENVIRONMENT=production
JWT_SECRET=6RQErJW/hnkOD9du7fu+rD6O6UNGHppl69K+aorpV5M7ojZTPzBiw9cr43wxdvIv
JWT_ALGORITHM=HS256
ADMIN_API_KEY=jAUYVXwDpBZbXaTYu8DYzXR2EoVWhEZEopj5XWK8feM=
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
SESSION_COOKIE_SECURE=true

# Public frontend values. These are baked into the Next.js image at build time;
# rebuild frontend after changing any NEXT_PUBLIC_* value.
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_MEDIA_URL=https://yourdomain.com/static
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_ANALYTICS_CONSENT_VERSION=2026-07-31

# Server-only URL for Next.js Server Components to reach the backend over the
# internal Docker network. NOT a NEXT_PUBLIC_ var (never sent to the browser),
# and read at runtime (no rebuild needed). Defaults to http://backend:8001.
API_INTERNAL_URL=http://backend:8001

# Social links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/atelier_marie25?igsh=MWQ1YzA4aHF2a3Q4MA==
