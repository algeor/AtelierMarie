# Copy to .env.docker for Docker Compose deployments.
# Do not commit real secrets.

# Backend
ENVIRONMENT=production
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ADMIN_API_KEY=replace-with-at-least-32-characters
FRONTEND_URL=https://yourdomain.com
CORS_ORIGINS=["https://yourdomain.com","https://www.yourdomain.com"]
SESSION_COOKIE_SECURE=true
DATABASE_URL=postgresql://atelier:atelier@postgres:5432/atelier_marie
# Database concurrency (design Decision 14). Threadpool must be >= pool max size.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=8.0
SERVER_THREADPOOL_SIZE=24

# Public frontend values. These are baked into the Next.js image at build time;
# rebuild frontend after changing any NEXT_PUBLIC_* value.
NEXT_PUBLIC_API_URL=https://yourdomain.com
NEXT_PUBLIC_MEDIA_URL=https://yourdomain.com/static
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_ANALYTICS_CONSENT_VERSION=2026-07-31

# Social links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/atelier_marie25?igsh=MWQ1YzA4aHF2a3Q4MA==
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@ateliermarie25?_r=1&_t=ZN-98H9buODbdu

# Payments shown in checkout UI
NEXT_PUBLIC_STRIPE_ENABLED=false
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_BIC=
NEXT_PUBLIC_BANK_NAME=

# Stripe backend integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://yourdomain.com/en/orders/{order_id}
STRIPE_CANCEL_URL=https://yourdomain.com/en/checkout

# Email notifications
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@theateliermarie.com
EMAIL_FROM_NAME=Atelier Marie
EMAIL_REPLY_TO=contacts@theateliermarie.com
ADMIN_NOTIFICATION_EMAIL=
ZEPTOMAIL_WEBHOOK_AUTH_KEY=

# First-party analytics. Keep disabled until consent/legal approval is ready.
ANALYTICS_ENABLED=false
ANALYTICS_LEGAL_APPROVED=false
ANALYTICS_BATCH_SIZE=25
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_DELIVERY_TOLERANCE=0

# Courier APIs
SPEEDY_API_USERNAME=
SPEEDY_API_PASSWORD=
SPEEDY_CLIENT_ID=
SPEEDY_BASE_URL=https://api.speedy.bg/v1
ECONT_API_USERNAME=
ECONT_API_PASSWORD=
ECONT_SENDER_OFFICE_ID=
ECONT_CALCULATE_URL=https://ee.econt.com/services/Shipments/LabelService.createLabel.json
ECONT_SENDER_NAME=Atelier Marie
ECONT_SENDER_PHONE=0899869055
ECONT_SENDER_ADDRESS=жк Красно село ул. Царица Елеонора №12
ECONT_SENDER_CITY=София
