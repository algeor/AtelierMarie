# Backend API URL (default: http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public product media URL for /static/* assets. Leave blank in mock mode to use frontend/public/static.
# NEXT_PUBLIC_MEDIA_URL=http://localhost:8000

# Use mock API data instead of real backend (default: true)
NEXT_PUBLIC_USE_MOCK_API=true

# Stripe — set to "true" to show card payment option in checkout
# NEXT_PUBLIC_STRIPE_ENABLED=true

# Bank transfer — set IBAN to enable bank transfer option in checkout
# NEXT_PUBLIC_BANK_IBAN=BG80BNBG96611020345678
# NEXT_PUBLIC_BANK_BIC=BNBGBGSD
# NEXT_PUBLIC_BANK_NAME=Test Bank

# Optional local fallback for the Econt Office Locator. Checkout normally reads backend /v1/delivery/config.
NEXT_PUBLIC_ECONT_OFFICE_LOCATOR_ENABLED=false
# NEXT_PUBLIC_ECONT_OFFICE_LOCATOR_URL=https://delivery-demo.econt.com/customer_info.php
# NEXT_PUBLIC_ECONT_OFFICE_LOCATOR_ORIGINS=https://delivery-demo.econt.com

# Public social profile links
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/atelier_marie25?igsh=MWQ1YzA4aHF2a3Q4MA==
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@ateliermarie25?_r=1&_t=ZN-98H9buODbdu
