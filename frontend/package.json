{
  "name": "atelier-marie-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_DIST_DIR=.next-dev next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:chrome": "node ../scripts/chrome_smoke.mjs",
    "test:chrome:stack": "CHROME_SMOKE_START_SERVERS=1 node ../scripts/chrome_smoke.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "^15.5.21",
    "next-intl": "^4.13.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-easy-crop": "^6.2.3",
    "tailwind-merge": "^3.6.0",
    "yet-another-react-lightbox": "^3.32.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "$postcss",
    "sharp": "0.35.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "^15.5.21",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  }
}
