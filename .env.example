# Environment (development | production)
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://atelier:atelier@localhost:5432/atelier_marie
# Database concurrency (design Decision 14). Threadpool must be >= pool max size.
# Bounded above by Postgres max_connections (~100) on a single VPS.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_SECONDS=8.0
SERVER_THREADPOOL_SIZE=24
# Auth — MUST be changed in production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin API key — MUST be set in production
ADMIN_API_KEY=

# CORS allowed origins (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Static files
STATIC_FILE_PATH=./static

# Object storage (Cloudflare R2, S3-compatible) for product media.
# Leave empty for local dev; media uploads/deletes require these to be set.
R2_BUCKET=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Product videos
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_UPLOAD_TEMP_PATH=./video-temp
MAX_VIDEO_UPLOAD_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=30

# Session
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE=2592000

# First-party analytics
# Disabled by default. In production, ANALYTICS_ENABLED=true is rejected unless
# ANALYTICS_LEGAL_APPROVED=true is also set after owner/legal review.
ANALYTICS_ENABLED=false
ANALYTICS_DATA_DIR=./analytics-data
ANALYTICS_EVENTS_JSONL_PATH=./analytics-data/events.jsonl
ANALYTICS_DUCKDB_PATH=./analytics-data/analytics.duckdb
ANALYTICS_CONSENT_VERSION=2026-07-31
ANALYTICS_BATCH_SIZE=25
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_DELIVERY_TOLERANCE=0
ANALYTICS_LEGAL_APPROVED=false

# Email notifications
# Keep console during development until a verified sending domain is ready.
EMAIL_PROVIDER=console

# ZeptoMail "Send Mail" token (required when EMAIL_PROVIDER=zeptomail)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@theateliermarie.com
EMAIL_FROM_NAME=Atelier Marie
EMAIL_REPLY_TO=contacts@theateliermarie.com
ADMIN_NOTIFICATION_EMAIL=
# ZeptoMail webhook signing key (bounce/complaint endpoint signature verification)
ZEPTOMAIL_WEBHOOK_AUTH_KEY=

# Stripe payments
# Card payments remain disabled in DB settings until configured and enabled by admin
# at /admin/settings/payments. Production card payments require live Stripe keys
# and a webhook secret from the live webhook endpoint.
STRIPE_SECRET_KEY=
# Local webhook testing:
# 1. Run `make stripe-webhook-secret` and copy the printed whsec_ value here.
# 2. Restart `make dev-backend`.
# 3. Run `make dev-stripe-webhook` in another terminal.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/orders/{order_id}/confirmation?token={payment_return_token}
STRIPE_CANCEL_URL=http://localhost:3000/orders/{order_id}/retry-payment?token={payment_return_token}
# Used only by scripts/stripe_webhook_forward.py; ignored by the backend app.
STRIPE_WEBHOOK_FORWARD_TO=http://127.0.0.1:8000/v1/webhooks/stripe
STRIPE_WEBHOOK_EVENTS=checkout.session.completed,payment_intent.payment_failed,checkout.session.expired,charge.refunded

# Bank transfer instructions
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Courier pricing APIs
SPEEDY_API_USERNAME=
SPEEDY_API_PASSWORD=
SPEEDY_CLIENT_ID=
SPEEDY_BASE_URL=https://api.speedy.bg/v1
ECONT_API_USERNAME=
ECONT_API_PASSWORD=
ECONT_CALCULATE_URL=https://ee.econt.com/services/Shipments/LabelService.createLabel.json
ECONT_SENDER_NAME=Atelier Marie
ECONT_SENDER_PHONE=0899869055
ECONT_SENDER_ADDRESS=
ECONT_SENDER_CITY=

# Econt Delivery integration
# Use demo until an Econt account manager confirms the payloads and labels.
ECONT_DELIVERY_BASE_URL=https://delivery-demo.econt.com/services/
# Private connection code only; do not include the shop id prefix.
ECONT_DELIVERY_PRIVATE_KEY=
ECONT_DELIVERY_SHOP_ID=
# Optional overrides. When unset, the app derives the locator URL/origin from Econt environment.
# ECONT_OFFICE_LOCATOR_URL=
# ECONT_OFFICE_LOCATOR_ORIGINS=["https://delivery-demo.econt.com"]
# Required only if stored Econt secrets are enabled later; env-backed secrets do not need it.
ECONT_SECRET_ENCRYPTION_KEY=
