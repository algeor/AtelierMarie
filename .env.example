# Environment (development | production)
ENVIRONMENT=development

# Database
DATABASE_PATH=./atelier_marie.db

# Auth — MUST be changed in production
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin API key — MUST be set in production
ADMIN_API_KEY=

# CORS allowed origins (JSON list)
CORS_ORIGINS=["http://localhost:3000"]

# Static files
STATIC_FILE_PATH=./static

# Product videos
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_UPLOAD_TEMP_PATH=./video-temp
MAX_VIDEO_UPLOAD_BYTES=209715200
MAX_VIDEO_DURATION_SECONDS=30

# Session
SESSION_COOKIE_NAME=session_id
SESSION_MAX_AGE=2592000

# First-party analytics
# Disabled by default. In production, ANALYTICS_ENABLED=true is rejected unless
# ANALYTICS_LEGAL_APPROVED=true is also set after owner/legal review.
ANALYTICS_ENABLED=false
ANALYTICS_DATA_DIR=./analytics-data
ANALYTICS_EVENTS_JSONL_PATH=./analytics-data/events.jsonl
ANALYTICS_DUCKDB_PATH=./analytics-data/analytics.duckdb
ANALYTICS_CONSENT_VERSION=2026-07-31
ANALYTICS_BATCH_SIZE=25
ANALYTICS_RETENTION_DAYS=395
ANALYTICS_DELIVERY_TOLERANCE=0
ANALYTICS_LEGAL_APPROVED=false

# Email notifications
# Keep console during development until a verified sending domain is ready.
EMAIL_PROVIDER=console

# ZeptoMail "Send Mail" token (required when EMAIL_PROVIDER=zeptomail)
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=orders@theateliermarie.com
EMAIL_FROM_NAME=Atelier Marie
EMAIL_REPLY_TO=contacts@theateliermarie.com
ADMIN_NOTIFICATION_EMAIL=
# ZeptoMail webhook signing key (bounce/complaint endpoint signature verification)
ZEPTOMAIL_WEBHOOK_AUTH_KEY=

# Stripe payments
# Card payments remain disabled in DB settings until configured and enabled by admin
# at /admin/settings/payments. Production card payments require live Stripe keys
# and a webhook secret from the live webhook endpoint.
STRIPE_SECRET_KEY=
# Local webhook testing: use the secret printed by `stripe listen --print-secret`.
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=http://localhost:3000/orders/{order_id}/confirmation?token={payment_return_token}
STRIPE_CANCEL_URL=http://localhost:3000/orders/{order_id}/retry-payment?token={payment_return_token}

# Bank transfer instructions
BANK_IBAN=
BANK_BIC=
BANK_NAME=
